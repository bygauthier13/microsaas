# RepairClock configuration. Copy to .env.local and fill in what you need.
# Every external service is optional: with nothing set, the app runs end-to-end locally
# (embedded database, emails recorded in the in-app outbox, simulated billing, AI drafting off).

# --- App -----------------------------------------------------------------------------------
# Public base URL, used in emailed links (approval links, password resets, Stripe redirects).
APP_URL=http://localhost:3000

# --- Database ------------------------------------------------------------------------------
# Postgres connection string (Neon, Supabase, RDS, local Postgres...). Leave empty to use the
# embedded PGlite database in .data/pglite (single process — fine for local dev and demos only).
DATABASE_URL=
# DATABASE_SSL=true            # force TLS on/off (default: on unless the host is localhost)
# DATABASE_POOL_MAX=5
# DB_AUTO_MIGRATE=true         # apply ./drizzle migrations on startup (default true)
# PGLITE_DIR=.data/pglite      # embedded database location

# --- Email (Resend) ------------------------------------------------------------------------
# Without a key, every email is recorded in the outbox (Sent emails page) instead of being sent.
RESEND_API_KEY=replace_me
EMAIL_FROM="RepairClock <notifications@yourdomain.co.uk>"

# --- Billing (Stripe, test mode) -----------------------------------------------------------
# Without STRIPE_SECRET_KEY the app uses simulated billing (plans activate instantly, no card).
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
# Created by `npm run stripe:setup` (prints these lines for you):
STRIPE_PRICE_LANDLORD_MONTHLY=
STRIPE_PRICE_LANDLORD_ANNUAL=
STRIPE_PRICE_AGENT_MONTHLY=
STRIPE_PRICE_AGENT_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=
STRIPE_PRICE_HOUSING_MONTHLY=
STRIPE_PRICE_HOUSING_ANNUAL=
STRIPE_PORTAL_CONFIGURATION_ID=
# BILLING_MODE=stripe|simulated     # force a mode
# ALLOW_SIMULATED_BILLING=true      # allow simulated billing in production (staging demos only)

# --- AI drafting (Anthropic) ---------------------------------------------------------------
# Enables "Improve with AI" on written summaries. Personal details are redacted before sending.
ANTHROPIC_API_KEY=replace_me
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Analytics (optional) ------------------------------------------------------------------
# Events are always stored in the analytics_events table; PostHog mirroring is optional.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Operations ----------------------------------------------------------------------------
# Required in production for /api/cron/daily (Vercel Cron sends it as a Bearer token).
CRON_SECRET=replace_me
# DEMO_ENABLED=true             # set to false to switch off the public demo workspace
# SIGNUP_RATE_LIMIT=8           # sign-ups per IP per hour (default 8 in production)

# --- Legal entity (shown on the privacy notice and terms) ----------------------------------
COMPANY_NAME=
COMPANY_NUMBER=
COMPANY_ADDRESS=
SUPPORT_EMAIL=hello@repairclock.co.uk
